flowchart LR
  classDef entry fill:#0f172a,stroke:#38bdf8,color:#f8fafc,stroke-width:1.5px,font-size:20px
  classDef control fill:#eef2ff,stroke:#6366f1,color:#1e1b4b,stroke-width:1.5px,font-size:20px
  classDef cognitive fill:#ecfeff,stroke:#0891b2,color:#164e63,stroke-width:1.5px,font-size:20px
  classDef exec fill:#f0fdf4,stroke:#16a34a,color:#14532d,stroke-width:1.5px,font-size:20px
  classDef integ fill:#fff7ed,stroke:#ea580c,color:#7c2d12,stroke-width:1.5px,font-size:20px
  classDef store fill:#faf5ff,stroke:#9333ea,color:#581c87,stroke-width:1.5px,font-size:20px
  classDef planned fill:#f8fafc,stroke:#94a3b8,color:#475569,stroke-dasharray:5 4

  subgraph ENTRY["Entry Surface"]
    TUI["TUI / CLI"]:::entry
    DESKTOP["Desktop Host"]:::entry
    PAR["Parallel Sessions"]:::entry
  end

  subgraph ORCH["Go Production Runtime — Orchestration & Control"]
    AGENT["Agent Loop / Run Supervisor"]:::exec
    WF["Workflow Contract<br/>Facts · Action · Route · Outcome · Gate"]:::control
    POLICY["Permission Policy<br/>read-only · workspace · full"]:::control
    SESSION["Durable Session<br/>Messages · Steps · Usage · Status"]:::store
  end

  subgraph COG["Cognitive Plane"]
    SEARCH["FTS5 + Symbol Retrieval"]:::cognitive
    LIGHT["Attention Light"]:::cognitive
    ACTIVE["Active Subgraph"]:::cognitive
    PROMOTE["Active Promotion"]:::cognitive
    GRAPH["Persistent Context Graph<br/>Evidence · Belief · Task · Abstraction"]:::store
    CGIT["Cognitive Git"]:::store
    GOV["Go Graph Governor<br/>Read-only Analyze · Plan · Validate"]:::control
  end

  subgraph EXEC["Execution & Editing Plane"]
    LLM["LLM Provider"]:::exec
    TOOLSET["Per-step Tool Working Set"]:::exec
    TOOLS["Workspace Tools"]:::exec
    EDIT["Editing Engine<br/>Hashline · Go AST · Atomic Commit"]:::exec
    SUB["Subagents"]:::exec
    HUB["Agent Hub<br/>Task DAG · Messages · Handoff"]:::exec
  end

  subgraph INTEG["External / Runtime Integration"]
    SHELL["Shell / Tests"]:::integ
    LSP["LSP"]:::integ
    MCP["MCP"]:::integ
    DAP["DAP Debugger"]:::integ
    EVAL["Persistent Python / JS Eval"]:::integ
    REPO["Workspace / Repository"]:::integ
  end

  subgraph STORE["Persistence"]
    SQLITE["SQLite WAL<br/>Graph · Sessions · Journal · Search · Cognitive Git"]:::store
    WORKTREE["Optional Session Worktrees"]:::store
    VECTOR["Semantic / Vector Retrieval<br/>Not in Go production baseline"]:::planned
  end

  TUI --> AGENT
  DESKTOP --> AGENT
  PAR --> AGENT
  SESSION <--> AGENT
  WF --> AGENT
  POLICY --> TOOLSET
  AGENT --> SEARCH --> LIGHT --> ACTIVE
  GRAPH --> LIGHT
  ACTIVE --> AGENT
  ACTIVE --> PROMOTE --> GRAPH
  GRAPH <--> CGIT
  GRAPH --> GOV
  AGENT <--> LLM
  AGENT --> TOOLSET --> TOOLS
  TOOLS --> EDIT --> REPO
  AGENT --> SUB
  AGENT --> HUB
  TOOLS --> SHELL
  TOOLS --> LSP
  TOOLS --> MCP
  TOOLS --> DAP
  TOOLS --> EVAL
  SHELL --> REPO
  REPO --> GRAPH
  GRAPH --> SQLITE
  SESSION --> SQLITE
  CGIT --> SQLITE
  SEARCH --> SQLITE
  WORKTREE -.-> REPO
  VECTOR -.-> SEARCH
