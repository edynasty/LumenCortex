+	for _, root := range []string{"/etc", "/var", "/tmp", "/usr", "/opt", "/dev", "/System", "/Library", "/Users", "/home", "/root", "/private", "/proc", "/sys"} {
+		if tok == root || strings.HasPrefix(tok, root+"/") {
