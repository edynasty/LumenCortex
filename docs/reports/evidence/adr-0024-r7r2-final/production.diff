+// memoStrings returns f memoized over [0, n).
+func memoStrings(n int, f func(int) string) func(int) string {
+	values, known := make([]string, n), make([]bool, n)
+	return func(i int) string {
+		if !known[i] {
+			values[i], known[i] = f(i), true
+		}
+		return values[i]
+	}
 }
 
